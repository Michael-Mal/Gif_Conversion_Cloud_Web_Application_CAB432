{
    "configurations": [
        {
            "name": "Python Debugger: app.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app.py",
            "env": { 
                "PYTHONPATH": "${workspaceFolder}",
                "DEV_MODE": "true"
            }
        }
    ]
}